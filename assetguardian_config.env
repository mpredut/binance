# ============================================================================
# assetguardian_config.env — parametri tunabili din assetguardian.py (CONFIG
# versionat, se COMITE — fara secrete). Incarcat automat de assetguardian.py
# la pornire (botcore.load_dotenv), inainte de orice os.environ.get(...) din
# fisier.
#
# 23 iul: valorile de mai jos au fost extrase din constante hardcodate.
# 26 aug: semnalul a fost schimbat explicit la evaluare si executie per activ;
# pragurile si ponderile financiare au ramas neschimbate.
#
# ATENTIE la bani reali: schimbarea acestor valori schimba DIRECT cand
# assetguardian vinde/cumpara fiecare activ urmarit separat. Vezi comentariul
# din cod: TARGET_GROWTH_PERCENT=100
# e intentionat "practic oprit" (walk-forward 291z a aratat ca vanzarea
# agresiva pierde fata de detinere) — protectia reala de crash e in
# trailing_stop.py, nu aici.
# ============================================================================

# Interval intre doua evaluari ale buclei principale (run_forever).
AG_CHECK_INTERVAL_SEC=54

# Simbolurile evaluate independent. Trebuie sa existe si in symbols.py.
AG_SYMBOLS=BTCUSDC,TAOUSDC

# Prag de crestere (%) al pretului fiecarui activ fata de minimul propriu din
# fereastra de referinta. Se incearca SELL numai pentru activul declansator.
# 100 = practic oprit (vezi comentariul din cod pt motivul istoric).
AG_TARGET_GROWTH_PCT=100.0

# Primul prag de scadere (%) al pretului fiecarui activ fata de maximul propriu.
AG_TARGET_DROP_PCT=7.0

# Fereastra (minute) folosita ca referinta pt calculul cresterii/scaderii
# fiecarui simbol din cache-ul Price24. 1440 = 24h.
AG_REFERENCE_MINUTES_BACK=1440

# Fractia maxima din cash-ul USDC liber care formeaza bugetul unei campanii
# per activ (0.995 = 99.5%, restul ramane tampon pt comisioane/precizie).
AG_BUY_USE_CASH_RATIO=0.995

# Transe BUY per activ: drawdown_pct:pondere_din_bugetul acelui activ.
# Fiecare transa acceptata este executata o singura data pana la rearmare.
# Cash-ul este comun; maximum un ordin acceptat este emis intr-un ciclu.
AG_BUY_TIERS=7:0.35,10:0.35,14:0.30

# Rearmeaza separat campania activului dupa recuperarea sub acest drawdown.
AG_RECOVERY_RESET_PCT=3.0

# Interval dinamic: normal 54s, aproape de urmatorul prag al oricarui activ
# 30s, iar cat timp o transa valida este refuzata de safe-order 15s.
AG_NEAR_TRIGGER_SEC=30
AG_ACTIVE_TRIGGER_SEC=15
AG_NEAR_TRIGGER_DISTANCE_PCT=2.0
