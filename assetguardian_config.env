# ============================================================================
# assetguardian_config.env — parametri tunabili din assetguardian.py (CONFIG
# versionat, se COMITE — fara secrete). Incarcat automat de assetguardian.py
# la pornire (botcore.load_dotenv), inainte de orice os.environ.get(...) din
# fisier.
#
# 23 iul: valorile de mai jos au fost extrase din constante hardcodate.
# 26 aug: semnalele si campaniile sunt evaluate/executate separat per activ.
# BUY-ul ocoleste numai referinta istorica SELL. SELL-ul pastreaza verificarea
# profitului, dar transele explicite ocolesc numai plafonul dinamic weight.
#
# TOATE cheile AG_* de mai jos sunt obligatorii. Codul nu are valori implicite;
# lipsa sau valoarea goala/invalida opreste procesul la pornire.
#
# ATENTIE la bani reali: schimbarea acestor valori schimba DIRECT cand
# assetguardian vinde/cumpara fiecare activ urmarit separat. Protectia reala de
# crash ramane in trailing_stop.py; SELL tiers sunt profit-taking, nu stop-loss.
# ============================================================================

# Interval intre doua evaluari ale buclei principale (run_forever).
AG_CHECK_INTERVAL_SEC=54

# Simbolurile evaluate independent. Trebuie sa existe si in symbols.py.
AG_SYMBOLS=BTCUSDC,TAOUSDC

# Transe SELL per activ: crestere_pct:pondere_din_cantitatea initiala a
# campaniei. La prima transa se ingheata minimul ferestrei si soldul liber.
# Profit-reference ramane activ; numai quantity/weight policy este ocolita.
AG_SELL_TIERS=15:0.30,25:0.30,35:0.40

# Histerezis fata de minimul inghetat. Dupa pornirea unei campanii SELL,
# revenirea pretului la cel mult +5% fata de acel minim sterge campania; o
# campanie viitoare va folosi din nou minimul mobil curent al ferestrei.
AG_SELL_REARM_GROWTH_PCT=5

# TTL operational comun pentru un ordin limit BUY/SELL creat de AssetGuardian.
# Dupa 900s, Guardianul reinterogheaza ordinul propriu dupa orderId/clientOrderId
# si cere o singura anulare. Nu anuleaza ordinele altor module. Un cancel ambiguu
# ramane pending/fail-closed si nu permite resubmit automat.
AG_ORDER_MAX_AGE_SEC=900

# Cate raspunsuri consecutive "nu exista ordin cu acest client_order_id" sunt
# necesare inainte ca o intentie ambigua sa fie eliberata fara fill.
AG_ORDER_MISSING_CONFIRMATIONS=1

# AssetGuardian nu doarme in Instrument.place. Daca trendul scurt favorizeaza un
# pret mai bun, intentia este amanata non-blocant si reevaluata la fiecare ciclu,
# maximum 180s. La expirare se plaseaza numai daca semnalul este inca valid.
AG_TREND_DEFER_MAX_SEC=180

# Fereastra (minute) folosita ca referinta pt calculul cresterii/scaderii
# fiecarui simbol din cache-ul Price24. 1440 = 24h.
AG_REFERENCE_MINUTES_BACK=1440

# Fractia maxima din cash-ul USDC liber care formeaza bugetul unei campanii
# per activ (0.995 = 99.5%, restul ramane tampon pt comisioane/precizie).
AG_BUY_USE_CASH_RATIO=0.995

# Transe BUY per activ: drawdown_pct:pondere_din_bugetul acelui activ.
# Numai un fill terminal completeaza transa; partialul scade doar costul real.
# Cash-ul este comun; maximum un ordin acceptat este emis intr-un ciclu.
AG_BUY_TIERS=7:0.35,10:0.35,14:0.30

# Rearmeaza separat campania activului dupa recuperarea sub acest drawdown.
AG_RECOVERY_RESET_PCT=3.0

# Interval dinamic: normal 54s, aproape de urmatorul prag al oricarui activ
# 30s, iar cat timp o transa valida este refuzata de safe-order 15s.
AG_NEAR_TRIGGER_SEC=30
AG_ACTIVE_TRIGGER_SEC=15
AG_NEAR_TRIGGER_DISTANCE_PCT=2.0
