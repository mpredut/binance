[Unit]
# systemd template for the Hyperliquid delta-neutral bot.
# Render it with systemd/install_prod.sh --render-only before installation.
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hl-dn
# Monitor: journalctl -u hl-dn -f
Description=Hyperliquid delta-neutral bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@TRADING_USER@
WorkingDirectory=@TRADING_ROOT@/hyperliquid
ExecStart=@TRADING_PYTHON@ @TRADING_ROOT@/hyperliquid/dn_bot.py
Restart=always
RestartSec=15
StandardOutput=append:@TRADING_ROOT@/hyperliquid/dn.log
StandardError=append:@TRADING_ROOT@/hyperliquid/dn.log

[Install]
WantedBy=multi-user.target
