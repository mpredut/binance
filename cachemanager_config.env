# ============================================================================
# cachemanager_config.env — parametri tunabili din cacheManager.py (CONFIG
# versionat, se COMITE — fara secrete). Incarcat automat de cacheManager.py la
# import (botcore.load_dotenv), inainte de orice os.environ.get(...) din fisier.
#
# 30 iul: prima extragere din acest fisier (fereastra dinamica de trend, cerere
# user: "sa pot dinamic sa cer trend pe x minute"). Restul constantelor din
# cacheManager.py (TREND_STALE_SEC, WINDOW_SECONDS, FULL_EVAL_INTERVAL_SEC etc.)
# raman deocamdata class-level (nu in scope acum — fisier mare, risc de regresie
# pe procesul care scrie cache_instant_trend.json pt toata flota).
#
# ATENTIE la bani reali: cacheManager.py e procesul care scrie
# cache_instant_trend.json, citit de monitortrades.is_trend_up() si de
# should_wait() (bapi_placeorder.__place_order). Schimbarea limitelor de mai jos
# afecteaza orice apelant care cere o fereastra dinamica (window_seconds custom
# in should_wait/get_instant_trend_for_window).
# ============================================================================

# Limitele ferestrei DINAMICE (secunde) pt trend calculat PE CERERE, pe orice
# durata din interval, direct din bufferul brut Cache24 (nu doar cele 2 ferestre
# fixe precalculate, 3.7min/2.5h). Sub minim: prea putine esantioane pt o panta
# cu sens. Peste maxim: cost de calcul nejustificat — si oricum plafonat de
# Cache24PriceManager.KEEP_HOURS=24h (nu poti cere un orizont mai lung decat ce
# se pastreaza in bufferul brut).
CM_DYNAMIC_WINDOW_MIN_SEC=14        # 14s (acelasi minim ca SMALL_TIMEOUT_RANGE_SEC din backtest)
CM_DYNAMIC_WINDOW_MAX_SEC=21600     # 6 ore (acopera si orizontul "mediu", 1.5-6h, deja testat in sweep)
