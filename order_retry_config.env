# ============================================================================
# order_retry_config.env — coada de RE-PLASARE a ordinelor esuate (30 iul).
# CONFIG versionat (se COMITE — fara secrete). Incarcat de order_retry.py la import.
#
# Idee: cand o plasare esueaza (orice motiv), ordinul se salveaza intr-o coada
# persistenta (outbox) si UN worker separat (order_retry_worker.py) o reia periodic,
# la PRET CURENT (recalculat, in avantaj), trecand din nou prin tot pipeline-ul
# (garduri + trend + cooldown). TTL configurabil: poate fi zile -> intentie
# PERSISTENTA (ordinul se executa cand se indeplinesc conditiile, chiar peste zile).
#
# ATENTIE bani reali: retry-ul re-ruleaza pipeline-ul (nu re-send orb) -> gardul de
# profit + anti-spam (recent_transaction 180s). In plus (31 iul) capteaza INTENTIA DE PRET
# la enqueue (pretul cerut + pretul de piata) si reia DOAR cand pretul curent e in avantaj
# vs cel cerut (RETRY_PRICE_TOL) -> fara ghost-orders; + DEDUP la enqueue (o intentie
# pending per symbol+side+banda pret) -> nu se mai inunda coada de refuzuri repetate.
# ============================================================================

# OPRIT fail-closed: workerul nu poate valida daca semnalul strategiei care a creat
# intentia mai este curent. Coada se pastreaza pentru reconciliere, fara executie.
# Reactivare doar dupa validare explicita a intent_id-ului la momentul retry-ului.
RETRY_ENABLED=false               # kill-switch (false = nu se mai salveaza/reia nimic)
RETRY_INTERVAL_SEC=300            # 5 min: cadenta minima intre 2 reincercari ale ACELUIASI ordin
RETRY_TTL_SEC=86400              # 1 zi implicit. Poate fi zile (intentie persistenta gardata pe pret).
                                 # Constrangere design: recent_transaction_sec(180) * x, si < safeback (14 zile).
RETRY_MAX_ATTEMPTS=0             # 0 = fara plafon dur (doar TTL). >0 = plafon de incercari per ordin.

# --- Gard de PRET la retry (intentia persistenta e conditionata de pret, nu oarba pe timp) ---
RETRY_PRICE_TOL=0.002           # reia doar daca pretul curent e in avantaj vs cel cerut, cu
                                # aceasta toleranta. SELL: current>=cerut*(1-tol); BUY: current<=cerut*(1+tol).
                                # 0 = strict (doar egal/mai bun); mai mare = mai permisiv.
# --- Dedup la enqueue (opreste inundarea cozii) ---
RETRY_DEDUP=true                # o SINGURA intentie pending per symbol+side (la re-cerere se
                                # reimprospateaza tinta, nu se acumuleaza). false = append mereu.
# --- Centura de siguranta ---
RETRY_MAX_QUEUE=500             # plafon dur pe nr intrari in coada (0 = fara). La plafon: NU mai adauga.
