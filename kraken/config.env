# ============================================================================
# Kraken — CONFIG versionat (se COMITE). Secretele sunt in .env (gitignored).
# The bot loads .env first (secrets and local overrides win), then this file.
# ============================================================================
KRAKEN_PAIR=HYPEUSD           # HYPEEUR sau HYPEUSD (--find-pair hype ca sa-l afli)
KRAKEN_BOT_POLL_SEC=60
KRAKEN_CACHE_PAIRS=HYPEUSD,TAOUSD,ADAUSD
KRAKEN_CACHE_POLL_S=30
KRAKEN_CACHE_BACKOFF_INIT_S=10
KRAKEN_CACHE_BACKOFF_MAX_S=120
KRAKEN_CACHE_MODE=poll
KRAKEN_CACHE_LOOKBACK_H=336
SYMBOL_LABEL=Kraken          # eticheta cosmetica banner/notificari (era gresit 'Hyperliquid')

# ============================================================================
# Strategie DCA + take-profit (sumele sunt in valuta de cotare a perechii)
# ============================================================================
STRAT_EXECUTE=true            # false = PAPER; true = BANI REALI. --paper forteaza PAPER.
STRATEGY_MODE=avg_tp          # avg_tp (cost mediu + take-profit) sau dca_only
STRAT_CURRENCY=USD            # valuta de cotare a perechii (HYPEUSD -> USD)
STRAT_ENTRY=650               # cumpararea initiala (15 iul: USDC convertit in USD -> alocare ~3900)
STRAT_ENTRY_DISCOUNT_PCT=0.8  # cumpara la market - acest %
STRAT_DCA=325                 # cumparare pe scadere (15 iul: scalat odata cu ENTRY)
STRAT_DCA_DROP_PCT=1.25       # 28 Jul: 1.0 -> 1.25 (the midpoint between the current 1.0 and the winning 1.5).
                              # Sweep #6 pe HYPEUSD (kraken/backtest.py) pe 2 regimuri: 1.5 bate
                              # 1.0 pe AMBELE (bull 120z: +6.68% vs +5.85%, maxDD $156 vs $186;
                              # decline 30z: -0.40% vs -0.55%, maxDD $202 vs $220) — return SI
                              # drawdown mai bune. Semnal modest pe date HYPE-only care se suprapun,
                              # deci amortizat la media 1.25 (aceeasi regula ca TAO mt.lost 4.9->5.25).
STRAT_DCA_SPACING_GROWTH_PCT=0 # 0 = current live; >0 gradually widens the spacing after each DCA
STRAT_TAKEPROFIT_PCT=5.0      # vinde tot la pret_mediu*(1+%) — calareste trendul, vinde rar (sweep +8.8%)
STRAT_CHECK_MINUTES=2         # la cate minute verifica pretul
STRAT_MAX_BUDGET=3900         # PLAFON cheltuit / ciclu (siguranta). Efectiv $3900 (650+10x325);
                              # cash total ~$4728 -> ~$800 raman TAMPON pt DCA-ul SPCX (decizie 15 iul).
STRAT_MAX_DCA_BUYS=10         # numar maxim de cumparari pe scadere
STRAT_ORDER_TTL_MIN=10        # re-places an unfilled buy after this many minutes if the price rose
STRAT_STOP_LOSS_PCT=12.5      # 4 aug: 7->12.5 (catastrofa-only). Backtest: 7% e cel mai prost
                              # din ambele lumi pe un DCA (taie revenirile -> +5% vs +14% in bull;
                              # nici cea mai buna protectie in declin). 12.5 = lat, pastreaza plasa
                              # of a crash without dumping on dips that recover. 0 = off.

# ============================================================================
# xStocks / alocare IPO SPCX (kraken_xstock_watch.py) — monitorizeaza alocarea de 7500$
# ============================================================================
XSTOCK_REGEX=SPCX|SPACEX      # ce cauta in balanta + perechi (regex, case-insensitive)
XSTOCK_QUOTE=USD              # daca apar mai multe perechi (USD+EUR), prefer-o pe asta
XSTOCK_CHECK_MINUTES=1        # la cate minute verifica
XSTOCK_ALLOC_PRICE=141.75     # costul REAL (135 + 5% prima Kraken, din ledger)
XSTOCK_TP_ALERT_PCT=41        # TRANSA 1 ~00: vinde JUMATATE (2.14 buc)
XSTOCK_TP2_ALERT_PCT=81       # TRANSA 2 ~56: vinde restul (sau sambata seara, oricum)
XSTOCK_SL_ALERT_PCT=12        # alert when it drops this % below the allocation price
XSTOCK_YAHOO=SPCX             # underlying price (Yahoo) while the pair is not on the Kraken API

# --- PORNIRE AUTOMATA bot (watcher-ul porneste singur kraken_bot la alocare) ---
# Conditii: alocare in cont + pereche listata pe API + XSTOCK_ALLOC_PRICE > 0.
# The watcher keeps the bot PID in state: no duplicate on restart; if the bot
# moare, il reporneste (strategia isi reia starea proprie — fara pozitii duble).
XSTOCK_AUTOSTART=true         # false = alerts only, no auto-start
XSTOCK_BOT_PAPER=false        # true = botul pornit automat ruleaza PAPER (test)
XSTOCK_BOT_TP_PCT=48          # tinta lui Marius: vinde la ~$200 (135 x 1.48 = 199.80)
                              # 20=lacom (risti sa ratezi varful si sa cobori spre stop-loss)
XSTOCK_BOT_DCA_DROP_PCT=4
XSTOCK_BOT_SL_PCT=12
XSTOCK_BOT_DCA=500            # USD per cumparare pe scadere (sume aprobate 12 iun)
XSTOCK_BOT_MAX_BUDGET=4000    # plafon bani aditionali / ciclu
XSTOCK_BOT_CHECK_MINUTES=1

# --- Adoptare pozitie existenta in kraken_bot (folosit de auto-start; manual:) ---
#   STRAT_ADOPT_COST=<pret_alocare> python3 kraken_bot.py --pair <PERECHE_SPCX>
STRAT_ADOPT_COST=0            # >0 = adopt the account position at this average cost (the allocation price)
STRAT_ADOPT_QTY=0             # 0 = read the quantity from the balance automatically
STRAT_REENTRY_DROP_PCT=2.2    # after a TP it re-enters only at -2.2% below the sold price (15 Jul: 1.5->2.2,
                              # reintrare mai prudenta cu sumele marite; in piata care scade, spre 3)
STRAT_REENTRY_TOLERANCE_PCT=0.05  # "close to the threshold" = reached (are_close from botcore, deterministic).
                              # Se aplica la REINTRARE si la DCA. (16 iul: HYPE a ricosat la
                              # 65.93 vs threshold 65.91 — 2 cents — and missed the entry)
STRAT_REENTRY_ADAPTIVE=false  # 30 iul: true->FALSE. Verificare ROBUSTA (14 ferestre, 4h ~120z
                              # that also cover the bull regime + 1h ~30d): FIXED >= adaptive EVERYWHERE
                              # (egal in 9/14, inclusiv tot bull-ul unde adaptivul nu ajuta deloc;
                              # FIXED wins 4/5 of those that differ, in DECLINE — e.g. 1h FULL -2.46%
                              # vs -4.19%, 1h H2 -6.07% vs -7.76%; singura victorie adaptiv marginala
                              # 0.38%). Verdictul VECHI (23 iul: adaptiv +3.26% vs +2.20% pe ~30z)
                              # was regime-dependent (a bull window, small sample) and does NOT hold on
                              # date fuller. FIX = mai bun/mai sigur in declin, identic in bull.
                              # 23 iul: prag adaptiv = SHADOW_K_REENTRY * vol_1h. Fail-safe pe fix oricum.
                              # DCA RAMANE FIX (adaptiv nu l-a batut, confirmat).
# --- TP IN TRANSE (optional): "3:50,6:50" = vinde 50% la +3%, restul la +6% ---
STRAT_TP_TRANCHES=            # gol = TP clasic (un singur ordin pe toata pozitia)

# TP TRAILING (v2, 19 Aug): above the TP level, instead of selling at a fixed point, RIDE the trend and exit
# la un pullback de STRAT_TP_TRAIL_PCT% de la varf. Sub TP nu vand (siguranta=stop-loss).
# Backtest faithful HYPEUSD multi-perioada: trail=3% robust (pozitiv 60m/240m/1440m, bate
# clasicul pe 240m +6.5% si 1440m +6.7%); trail=2% era overfit pe 240m (minus pe 2 ani).
STRAT_TP_TREND_HOLD=true      # activeaza trailing-ul (false = TP fix clasic)
STRAT_TP_TRAIL_PCT=3.0        # pullback de la varf la care ies (3% = alegerea robusta)
STRAT_TP_TRAIL_PROFIT_FLOOR_PCT=0  # 0 = live unchanged; the shadow candidate uses +1%

# Explicit shared-engine policy. Zero/false values intentionally disable features.
STRAT_TOTAL_BUDGET=0
STRAT_ALLOC_PCT=0
STRAT_ENTRY_PCT=0
STRAT_DCA_PCT=0
STRAT_REENTRY_SL_BOUNCE_PCT=1.5
STRAT_TP_TREND_MIN_PCT=0.5
STRAT_TREND_OVERLAY=false
STRAT_TREND_SMA_N=30
STRAT_TREND_INTERVAL=240
STRAT_TREND_CONFIRM_BARS=3
STRAT_TREND_TOPUP=2000
STRAT_TREND_TRAIL_PCT=5
STRAT_TREND_EXIT_BREAK=false
STRAT_TP_TRAIL_ADAPTIVE=false
STRAT_TP_TRAIL_K=2
STRAT_TP_TRAIL_MIN=1.5
STRAT_TP_TRAIL_MAX=8
STRAT_TP_TRAIL_VOL_INTERVAL=240
STRAT_DCA_TREND_BRAKE=false
STRAT_DCA_BRAKE_MIN_PCT=1.5
STRAT_DCA_VOL_SCALE_K=0
STRAT_DCA_VOL_REF=2
STRAT_DCA_VOL_INTERVAL=240
