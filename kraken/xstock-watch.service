# systemd template for the xStock watcher.
# Render it with systemd/install_prod.sh --render-only before installation.
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xstock-watch
# Check: systemctl status xstock-watch; journalctl -u xstock-watch -f
[Unit]
Description=Kraken xStock allocation watcher (SPCX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@TRADING_USER@
WorkingDirectory=@TRADING_ROOT@/kraken
ExecStart=@TRADING_PYTHON@ @TRADING_ROOT@/kraken/kraken_xstock_watch.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
