# ============================================================================
# bapi_placeorder_config.env — the tunable parameters of binance_api/bapi_placeorder.py
# (a VERSIONED config, it IS committed — no secrets). Loaded automatically by
# bapi_placeorder.py on import (botcore.load_dotenv), before any
# os.environ.get(...) in the file.
#
# 30 iul: valorile de mai jos erau constante HARDCODATE direct in cod pana
# today — extracted here with IDENTICAL DEFAULT values (zero change in
# behaviour if you change nothing). User request: inventory and pull out
# into config every parameter, threshold and multiplier in the bots (the same treatment
# already applied to tradeall_config.env / monitortrades_config.env, 23 Jul).
#
# CAUTION, this is real money: this file controls the final CHOKEPOINT of
# order placement (__place_order), used by the WHOLE trading chain
# (tradeall, monitortrades, rtrade, market_api). Changing these values
# DIRECTLY change when, how much and how real BUY/SELL orders are sent.
# ============================================================================

PLACE_ORDER_FEE_PCT=0.001          # The estimated fee, used when adjusting qty (BUY/SELL) next to the fee.
PLACE_ORDER_HOURS=5                # The window (hours) for cancel_orders_old_or_outlier when releasing qty.

# cat de departe in urma cauta place_safe_order/if_place_safe_order tranzactii
# recente pt gardul anti-spam ("recent_transaction"/"daily_limit") + referinta gardului
# de profit. 30 iul: 48h -> 14 zile (cerere user "tot la valoarea mare") — apelantii
# main ones (monitortrades 12 days, tradeall 14 days) already passed ~14 days explicitly; this
# the default affects callers that do NOT pass it (normal rtrade, monitororder, server,
# archive/monitortrades_legacy) -> their guard window rises from 48h to 14 days.
PLACE_ORDER_SAFEBACK_SEC=1209660   # 14 zile + 60s

PLACE_ORDER_MAX_DAILY_TRADES=25    # A cap on trades per day (if_place_safe_order) before a "daily_limit" refusal.
PLACE_ORDER_MIN_NOTIONAL=100       # business minimum; exchange minimum remains symbol metadata

# The trend is checked instantly in Instrument.place. There are no sleep/polling
# parameters here: a refusal goes into the outbox and is re-evaluated by the worker later.
