# ============================================================================
# bapi_placeorder_config.env — parametri tunabili din binance_api/bapi_placeorder.py
# (CONFIG versionat, se COMITE — fara secrete). Incarcat automat de
# bapi_placeorder.py la import (botcore.load_dotenv), inainte de orice
# os.environ.get(...) din fisier.
#
# 30 iul: valorile de mai jos erau constante HARDCODATE direct in cod pana
# acum — extrase aici cu valorile IMPLICITE identice (zero schimbare de
# comportament daca nu modifici nimic). Cerere user: inventariaza si scoate
# in config tot ce e parametru/prag/multiplicator din boti (acelasi tratament
# aplicat deja la tradeall_config.env / monitortrades_config.env, 23 iul).
#
# ATENTIE la bani reali: acest fisier controleaza CHOKEPOINT-ul final de
# plasare a ordinelor (__place_order), folosit de TOT lantul de trading
# (tradeall, monitortrades, rtrade, market_api). Schimbarea acestor valori
# schimba DIRECT cand/cat/cum se trimit ordine reale BUY/SELL.
# ============================================================================

PLACE_ORDER_FEE_PCT=0.001          # comision estimat, folosit la ajustarea qty (BUY/SELL) langa fee
PLACE_ORDER_HOURS=5                # fereastra (ore) pt cancel_orders_old_or_outlier la eliberare qty

# cat de departe in urma cauta place_safe_order/if_place_safe_order tranzactii
# recente pt gardul anti-spam ("recent_transaction"/"daily_limit") + referinta gardului
# de profit. 30 iul: 48h -> 14 zile (cerere user "tot la valoarea mare") — apelantii
# principali (monitortrades 12z, tradeall 14z) treceau deja ~14 zile explicit; acest
# default afecteaza apelantii care NU-l paseaza (rtrade normal, monitororder, server,
# archive/monitortrades_legacy) -> fereastra lor de gard urca de la 48h la 14 zile.
PLACE_ORDER_SAFEBACK_SEC=1209660   # 14 zile + 60s

PLACE_ORDER_MAX_DAILY_TRADES=25    # plafon tranzactii/zi (if_place_safe_order) inainte de refuz "daily_limit"

# Trendul este verificat instantaneu in Instrument.place. Nu exista parametri de
# sleep/polling aici: un refuz intra in outbox si este reevaluat de worker ulterior.
