# ============================================================================
# 212trading — PROFIL SPCX (SpaceX).  Selecteaza cu:  python3 ipo.py --profile spcx
# Se COMITE (config versionat). Secretele sunt in .env (gitignored).
# ============================================================================

ALERT_NEW_COIN=true

# --- Instrument ---
T212_TICKER=SPCX_US_EQ        # instrumentul exact pe T212 (--find-ticker ca sa-l afli)
YAHOO_SYMBOL=SPCX             # simbol Yahoo pt pret
SYMBOL_LABEL=SpaceX
# Lansarea se detecteaza AUTOMAT: deja-listat -> imediat; IPO (volum 0) -> la deschidere.
EXPECTED_ISIN=US84615Q1031    # guard: refuse if the ISIN does not match

# --- Strategie DCA + take-profit ---
STRAT_ENABLED=true            # true = strategie; false = un singur ordin (ORDER_* de mai jos)
STRAT_EXECUTE=true            # true = BANI REALI; false = PAPER. --paper forteaza PAPER.
STRATEGY_MODE=avg_tp          # avg_tp (cost mediu + take-profit) sau dca_only
STRAT_CURRENCY=USD            # The strategy budgets/amounts are in USD; the broker account is in RON (confirmed via API 2026-08-20).
# === REGLAT pt IPO SPCX cu volatilitate EXTREMA (oscilatii mari sus-jos) ===
# Logica: scaleaza pragurile la marimea swing-urilor ca sa NU vinzi pe zgomot,
# so you do NOT exhaust the budget in the first minute and are NOT stopped out on a normal swing.
STRAT_ENTRY_PCT=6             # intrare MINIMA = 6% din buget; cu contor auto se rotunjeste in SUS ca sa acopere integral (la buget 4000, DCA 10% => intrare reala 400/10%, 9 trepte). Vrei intrare mai mica? scade DCA_PCT.
STRAT_ENTRY_DISCOUNT_PCT=0.5  # spread mare la IPO; limit putin sub piata (TTL il reaseaza daca pretul fuge)
STRAT_DCA_PCT=10              # DCA = 10% din MAX_BUDGET (= 200 la buget 2000). Cu ENTRY_PCT -> contor auto = floor((1-6%)/10%) = 9
STRAT_DCA_DROP_PCT=4.0        # KEY: WIDE spacing -> the DCA ladder covers a big crash without leaving you out of budget
STRAT_DCA_TREND_GATE_PCT=0.10 # DCA trend GATE (2026-07-12): no DCA if the short slope (OLS over 12 Yahoo 5m candles) < -0.10%/bar = a confirmed downtrend. Reason: blind DCA into a fall lost -$161; same as the trend gate in monitortrades (Binance/Kraken). 0 = OFF.
STRAT_TAKEPROFIT_PCT=11       # fallback daca STRAT_TP_LADDER e gol; cu scara, primul nivel = +11%
STRAT_TP_LADDER=11:33,20:33,30:34   # SCALE-OUT (2026-06-23): sell 33% at +11%, 33% at +20%, 34% at +30% above the average. All above cost (profit guard). Empty => sell everything at TAKEPROFIT_PCT.
STRAT_CHECK_MINUTES=0.3       # piata rapida -> verifica mai des (~18s)
STRAT_MAX_BUDGET=4000         # MASTER. Cu ENTRY_PCT/DCA_PCT + contor auto: entry+N*DCA acopera INTEGRAL bugetul (intrarea absoarbe restul).
STRAT_FX_FEE_PCT=0.15         # RON base account -> the USD/RON conversion applies; 0 only after the account is really moved.
STRAT_MAX_DCA_BUYS=auto       # AUTO din buget: floor((MAX_BUDGET-ENTRY)/DCA) = (2000-120)/200 = 9 trepte. Schimbi bugetul/DCA -> se recalculeaza singur.
STRAT_ORDER_TTL_MIN=3         # piata rapida: reaseaza limit-ul des daca pretul a urcat
STRAT_STOP_LOSS_PCT=30        # PROFIT GUARD (2026-06-23): never sell at a loss; 30 = the CATASTROPHE net only. Normal exit = TP (profit) only. Buy only below last-sell (REENTRY_DROP_PCT).
STRAT_TRAIL_PCT=8             # TRAILING crash breaker (2026-07-12): sell everything if the price falls 8% from the position peak -> exit a sustained decline early, before the catastrophe (SPCX backtest 3mo/1h: -7.5% -> -1.4%). Complements the 30% SL and the DCA trend gate. Re-enters on a pullback via sl_rebuy. 0 = OFF.
STRAT_TRAIL_MIN_PROFIT_PCT=9  # WARM-UP (2026-07-13): trailing INACTIVE until the price rises +9% above avg. 9 = a MATHEMATICAL GUARANTEE of "never at a loss": worst-case sale = avg*1.09*0.92 = avg*1.0028 (~breakeven, FX included). The profit guard becomes a hard property, not a hope. 0 = armed immediately (loss cutter).
STRAT_SL_REBUY_ENABLED=true   # after a catastrophe (-30%), re-enter on an upward PULLBACK from the low (like Binance/Kraken trailing), not only below the sale -> it catches the recovery
STRAT_SL_REBUY_BOUNCE_PCT=1.2 # recul% de la minimul de dupa SL pt re-buy

# --- Single-order mode (ONLY if STRAT_ENABLED=false) ---
ORDER_PRICE=150
ORDER_BUDGET_RON=3000
ORDER_VALIDITY=DAY
ORDER_EXECUTE=true
STRAT_REENTRY_DROP_PCT=2      # after a TP it re-enters only at -2% below the sold price (anti-churn)
STRAT_REENTRY_TOLERANCE_PCT=0.05  # "aproape de prag" = atins (are_close): reintrare + DCA (16 iul)
STRAT_LOSS_ALERT_STEP=1
STRAT_LADDER_MIN_FREE=6
POLL_SECONDS=60
