# `pubip` este IP-ul conexiunii FIZICE (linia ISP-ului) si ramane pe el si cand
# tunelul e perfect sanatos — afisat singur, parea ca serverul iese neprotejat.
# Pentru whitelist-ul cheilor Binance conteaza `vpnip`: IP-ul prin care ies cererile.
printf "🔐 VPN State      : %s\n" "$(pia get connectionstate)"
printf "🔌 Port Forward   : %s\n" "$(pia get portforward)"
printf "🌍 IP iesire VPN  : %s\n" "$(pia get vpnip)"
printf "🏠 IP fizic ISP   : %s\n" "$(pia get pubip)"

