# piactl FARA timeout atarna la login: daca pia-daemon e agatat (s-a intamplat
# 34 de zile, aug-sep 2026), fiecare apel blocheaza ~5s si orice sesiune SSH devine
# lenta exact cand ai nevoie sa intri ca sa depanezi. Vezi systemd/PIA.md.
pia() { timeout 5 piactl "$@" 2>/dev/null; }

